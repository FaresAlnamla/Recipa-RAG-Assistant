# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=sk-your-key-here

# Models (Optional - defaults provided)
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Chroma Vector Store (Optional)
CHROMA_COLLECTION=cookbook-recipes
VECTORSTORE_DIR=./vectorstore/chroma

# Frontend Origin (for CORS - Optional)
FRONTEND_URL=http://localhost:3000

# Deployment Environment (Optional - defaults to development)
ENVIRONMENT=development

# Application Port (Optional - defaults to 8000)
PORT=8000